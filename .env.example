# Salin ke .env.local (di-gitignore) lalu isi.
# Key MAPID: Dashboard → Map Services → API Keys. Dipakai untuk basemap MAPID MAPS
# DAN endpoint kompetisi Activities (Community Maps live): server.mapid.io/web/competition/activities
VITE_MAPID_API_KEY=
# Untuk produksi (Vercel): set juga MAPID_API_KEY di Environment Variables proyek —
# dipakai api/activities.ts di server, tidak pernah dikirim ke browser.
MAPID_API_KEY=
# Opsional: style URL lengkap kalau ingin memaksa satu style tertentu.
VITE_MAPID_STYLE_URL=
# Asisten "Tanya AI": Gemini (free tier) dengan function calling, dipanggil langsung dari browser.
# Kunci dari aistudio.google.com → Get API key. Tanpa kunci, asisten memakai mode aturan.
VITE_GEMINI_API_KEY=
# Opsional: nama model (default gemini-3.6-flash).
VITE_GEMINI_MODEL=
# Model cadangan kalau model utama sedang penuh/sibuk (opsional, kosongkan bila tidak ada).
VITE_GEMINI_FALLBACK_MODEL=
